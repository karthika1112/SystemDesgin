# ==========================================
# SALESTORM ENVIRONMENT CONFIGURATION
# ==========================================

# SERVER CONFIGURATION
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# DATABASE
# Uses standard PostgreSQL connection string. DO NOT use root in production.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/salestorm?schema=public"

# REDIS
REDIS_URL="redis://localhost:6379"

# RABBITMQ
RABBITMQ_URL="amqp://guest:guest@localhost:5672"

# SECURITY & AUTHENTICATION
# Generate a strong 64-character hex string for production. Never commit this.
JWT_SECRET="development_super_secret_key_change_me_in_production"

# PAYMENT MOCK CONFIGURATION
# Options: SUCCESS | FAILURE | TIMEOUT | TIMEOUT_ONCE_THEN_SUCCESS
MOCK_PAYMENT_MODE="SUCCESS"

# AI CONFIGURATION (DECISION-SUPPORT ONLY)
AI_ENABLED=true
AI_PROVIDER=mock
# OPENAI_API_KEY=sk-...
