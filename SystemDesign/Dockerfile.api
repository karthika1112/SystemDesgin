FROM node:20-alpine

WORKDIR /app

# Copy workspace configurations
COPY package*.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/ packages/

# Install dependencies (Linux environment seamlessly handles workspace symlinks)
RUN npm install

# Copy source code
COPY apps/api/ apps/api/

# Generate Prisma Client
RUN cd packages/database && npx prisma generate

EXPOSE 3000

# Start API in development mode for the hackathon
CMD ["npm", "run", "dev", "-w", "@salestorm/api"]
